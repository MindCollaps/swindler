<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password changed</title>
</head>
<body style="margin:0;padding:24px;background:#18181B;color:#F3F4F6;font-family:'Noto Sans',Arial,sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;margin:0 auto;background:#27272A;border:1px solid #3F3F46;border-radius:8px;">
        <tr>
            <td style="padding:24px;">
                <h1 style="margin:0 0 16px 0;font-size:24px;line-height:1.2;">Your password was changed</h1>
                <p style="margin:0 0 12px 0;font-size:15px;line-height:1.6;color:#D4D4D8;">Hi {{username}},</p>
                <p style="margin:0 0 20px 0;font-size:15px;line-height:1.6;color:#D4D4D8;">This confirms that your Swindler password was updated successfully.</p>
                <p style="margin:0;font-size:13px;line-height:1.6;color:#A1A1AA;">If this was not you, reset your password immediately and contact support.</p>
            </td>
        </tr>
    </table>
</body>
</html>
